# ---- web (Cloudflare Worker vars / local .env) ----
NEXT_PUBLIC_SITE_URL=https://bias.michaelworkarb.workers.dev
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
SOLANA_RPC=                       # Helius Free (secret)
SOLANA_RPC_FALLBACK=https://api.mainnet-beta.solana.com
HL_NETWORK=testnet                # testnet | mainnet
TREASURY_PUBKEY=                  # receives launch fees; set to the platform vault printed by jobs/provision.ts
BIAS_MINT=                        # empty until $BIAS is launched (everyone counts as desk tier)
LAUNCH_FEE_SOL=0.02
VAULT_RENT_SOL=0.003
MAX_DEV_BUY_SOL=1
LAUNCH_COOLDOWN_MIN=15
LAUNCHES_ENABLED=true
TRADING_MODE=normal               # normal | close_only | halted (admin page overrides)
FEE_SPLIT_POSITION_BPS=7000
FEE_SPLIT_LAUNCHER_BPS=2000
FEE_SPLIT_PLATFORM_BPS=1000
MIN_CLAIM_SOL=0.02
MIN_BRIDGE_SOL=0.25
MIN_PAYOUT_SOL=0.05
MIN_BUYBACK_USD=15
MAX_LEVERAGE=5
MAX_LOSS_MARGIN_PCT=50
MAX_SLIPPAGE_BPS=50
BUYBACK_SLIPPAGE_BPS=300
MAX_NOTIONAL_PER_MARKET_USD=25000
MAX_TOTAL_NOTIONAL_USD=250000
GLOBAL_DRAWDOWN_HALT_PCT=20
VOTE_QUORUM_SUPPLY_PCT=1
TIER_TRADER=50000
TIER_DESK=500000
TIER_FUND=2000000
MAX_PRIORITY_MICROLAMPORTS=50000
ADMIN_WALLETS=                    # comma-separated solana addresses
DRY_RUN=false
DRY_RUN_PAYER=                    # funded mainnet address used as payer when simulating launches in DRY_RUN
LAUNCH_LOOKUP_TABLE=              # optional ALT so create + dev buy fit in one tx (see DECISIONS.md)
JOB_TOKEN=                        # secret shared by the worker and GitHub Actions (DB access for jobs)

# ---- GitHub Actions ONLY (never in Cloudflare) ----
MASTER_SEED=                      # buyback.yml only
AGENT_SEED=                       # tick.yml only
BIAS_DB_URL=https://bias.michaelworkarb.workers.dev/api/internal/sql

# ---- local dev ----
BIAS_SQLITE_PATH=                 # default apps/web/.data/bias.db
