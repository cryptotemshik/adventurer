{
  "name": "bias",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @bias/web dev",
    "build": "pnpm --filter @bias/web build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @bias/web test:e2e",
    "format": "prettier --write .",
    "deploy": "pnpm --filter @bias/web deploy",
    "job:tick": "tsx jobs/tick.ts",
    "job:buyback": "tsx jobs/buyback.ts",
    "job:reconcile": "tsx jobs/reconcile.ts",
    "twitter:images": "tsx twitter/generate.ts",
    "check:secrets": "node scripts/check-no-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.28",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
